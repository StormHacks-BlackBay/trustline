{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "server/**",
      "api/**",
      "src/lib/**",
      "src/data/**",
      "Dockerfile",
      "package.json",
      "package-lock.json",
      "tsconfig*.json",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
