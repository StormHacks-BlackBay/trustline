# Server only (Vercel environment variables). Never prefix these with VITE_.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5 for low latency.
ANTHROPIC_MODEL=

# Browser. Leave blank to run with the local demo store (no Supabase needed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phone calls (TrustLine merged into a call). The call server runs separately: npm run server.
VITE_CALL_SERVER_URL=
VITE_TRUSTLINE_NUMBER=

# Call server only (npm run server, or the Dockerfile on Railway / Fly.io / Render).
# Public https URL of the call server; Twilio's webhook and media stream use it.
PUBLIC_URL=
# From the Twilio console. Required in production to verify webhook signatures.
TWILIO_AUTH_TOKEN=
# Web app origin allowed to receive call events, e.g. https://trustline.vercel.app
APP_ORIGIN=
# Which demo user each phone belongs to, e.g. {"+16045550100":"harpreet","+17785550101":"mei"}
PHONE_LINKS=
# Optional voice and model for spoken warnings.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
